{
  "name": "phishing-attack-detection-prevention-system",
  "private": true,
  "version": "0.5.0",
  "description": "PhishGuard \u2014 a modular phishing detection and prevention platform.",
  "scripts": {
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:test": "npm --prefix frontend test",
    "backend:dev": "npm --prefix backend run dev",
    "backend:build": "npm --prefix backend run build",
    "backend:test": "npm --prefix backend test",
    "ml:train": "python3 ml-service/training/train.py",
    "ml:test": "python3 -m unittest discover -s ml-service/tests -p 'test_*.py'"
  },
  "engines": {
    "node": "24.21.x"
  },
  "packageManager": "npm@11.19.0"
}
