NODE_ENV=development
PORT=4000
HOST=0.0.0.0
TRUST_PROXY_HOPS=0
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://phishguard:phishguard@localhost:5432/phishing_detection?schema=public
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
AUTH_COOKIE_NAME=phishguard_access
CSRF_COOKIE_NAME=phishguard_csrf
AUTH_COOKIE_SAMESITE=lax
# Set true for HTTPS production; false for local HTTP development.
AUTH_COOKIE_SECURE=false
COOKIE_DOMAIN=
AUTH_SESSION_TTL_HOURS=12
LOG_LEVEL=info
APP_VERSION=0.5.0
JSON_BODY_LIMIT=32kb
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=100
SCAN_RATE_LIMIT_MAX=20
REPORT_RATE_LIMIT_MAX=10
ADMIN_WRITE_RATE_LIMIT_MAX=60
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT_MS=5000

APP_USER_AGENT=PhishGuard/0.5.0
THREAT_PROVIDER_TIMEOUT_MS=3500
THREAT_PROVIDER_MAX_RESPONSE_BYTES=512000
PHISHTANK_ENABLED=true
PHISHTANK_API_URL=http://checkurl.phishtank.com/checkurl/
PHISHTANK_APP_KEY=
PHISHTANK_USER_AGENT=phishguard-security-scanner/0.5.0
OPENPHISH_ENABLED=true
OPENPHISH_FEED_URL=https://raw.githubusercontent.com/openphish/public_feed/refs/heads/main/feed.txt
OPENPHISH_CACHE_TTL_MS=43200000
THREAT_RESULT_CACHE_TTL_MS=300000
THREAT_RESULT_CACHE_MAX_ENTRIES=2000
OPENPHISH_USER_AGENT=PhishGuard/0.5.0
GOOGLE_WEB_RISK_API_KEY=
GOOGLE_WEB_RISK_THREAT_TYPES=SOCIAL_ENGINEERING,MALWARE,UNWANTED_SOFTWARE
VIRUSTOTAL_ENABLED=false
VIRUSTOTAL_API_KEY=
RDAP_TIMEOUT_MS=3500
RDAP_MAX_RESPONSE_BYTES=1000000
RDAP_BOOTSTRAP_CACHE_TTL_MS=86400000
DNS_TIMEOUT_MS=2500
TLS_TIMEOUT_MS=2500

# Optional shared cache/rate-limit infrastructure
