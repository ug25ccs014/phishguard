# Docker Compose credentials/configuration
POSTGRES_DB=phishguard
POSTGRES_USER=phishguard
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
DOCKER_DATABASE_URL=postgresql://phishguard:replace-with-a-strong-postgres-password@postgres:5432/phishguard?schema=public

# Backend
NODE_ENV=development
PORT=4000
TRUST_PROXY_HOPS=0
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://phishguard:phishguard@localhost:5432/phishing_detection?schema=public
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
LOG_LEVEL=info
APP_VERSION=0.5.0
AUTH_COOKIE_SECURE=false

# ML service
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT_MS=5000
# Optional production pin for the exact model artifact
PHISHGUARD_MODEL_SHA256=

# Threat intelligence
PHISHTANK_ENABLED=true
PHISHTANK_API_URL=http://checkurl.phishtank.com/checkurl/
PHISHTANK_APP_KEY=
OPENPHISH_ENABLED=true
OPENPHISH_FEED_URL=https://raw.githubusercontent.com/openphish/public_feed/refs/heads/main/feed.txt
GOOGLE_WEB_RISK_API_KEY=
GOOGLE_WEB_RISK_THREAT_TYPES=SOCIAL_ENGINEERING,MALWARE,UNWANTED_SOFTWARE
VIRUSTOTAL_ENABLED=false
VIRUSTOTAL_API_KEY=
THREAT_PROVIDER_TIMEOUT_MS=3500
THREAT_PROVIDER_MAX_RESPONSE_BYTES=512000
RDAP_TIMEOUT_MS=3500
RDAP_MAX_RESPONSE_BYTES=1000000
DNS_TIMEOUT_MS=2500
TLS_TIMEOUT_MS=2500

# Frontend
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_CSRF_COOKIE_NAME=phishguard_csrf
